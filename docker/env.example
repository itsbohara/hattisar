# hattisar lean stack configuration.
# `scripts/dev-env.sh` (in a checkout) or `generate-env.sh` (in a release bundle) copies this file
# to .env and replaces every secret below with a freshly generated value. To fill them by hand,
# use `openssl rand -hex 32` (or `-hex 16` where noted). The placeholders here are for local
# development only.

# --- hattisar ---
HATTISAR_SECRET_KEY=dev-only-hattisar-secret-key-change-me
HATTISAR_ADMIN_USERNAME=admin
HATTISAR_ADMIN_PASSWORD=dev-only-admin-password
HATTISAR_PUBLIC_HOST=localhost
HATTISAR_PORT=8000
# The installer sets this to 127.0.0.1 so only Caddy or an SSH tunnel reaches hattisar.
HATTISAR_BIND=0.0.0.0
# The installer sets this when it serves a domain through Caddy (compose profile caddy).
HATTISAR_DOMAIN=
HATTISAR_COOKIE_SECURE=false
HATTISAR_PURGE_AFTER_DAYS=7
HATTISAR_BACKUP_HOUR_UTC=2
HATTISAR_PG_BIN_DIR=/usr/bin
HATTISAR_PG_META_TIMEOUT_SECONDS=120
HATTISAR_MANAGED_BOXES=false
HATTISAR_MANAGED_PORT_RANGE=55000-55999
# Read-only bind mounts added to every new managed box, comma-separated
# <host source>:<container target>; {box} in a source becomes the box name. Existing boxes are unchanged. See docs/pitr.md.
#HATTISAR_MANAGED_BOX_MOUNTS=/opt/wal-g/wal-g:/usr/local/bin/wal-g,/opt/wal-g/{box}.yaml:/etc/wal-g/walg.yaml
# Only used when managed boxes are on (start the stack with `--profile managed-boxes`). compose.yml
# sets hattisar's DOCKER_HOST to the docker-proxy service itself; this line does not change it.
DOCKER_HOST=tcp://docker-proxy:2375

# --- Studio and postgres-meta (internal service URLs; the compose file sets these) ---
STUDIO_URL=http://studio:3000
PG_META_URL=http://meta:8080
# Shared by hattisar, Studio and postgres-meta. At least 32 characters.
PG_META_CRYPTO_KEY=dev-only-pg-meta-crypto-key-change-me

# --- Shared box (db) and its pooler ---
POSTGRES_PASSWORD=dev-only-postgres-password
POOLER_TENANT_ID=hattisar
POOLER_PORT_SESSION=54322
POOLER_PORT_TRANSACTION=6543
# Supavisor internals. POOLER_VAULT_ENC_KEY must be exactly 32 characters (`openssl rand -hex 16`).
POOLER_SECRET_KEY_BASE=dev-only-pooler-secret-key-base-change-me-dev-only-pooler-secret-key
POOLER_VAULT_ENC_KEY=dev-only-vault-key-32-characters
# Also signs hattisar's calls to the Supavisor tenant API.
POOLER_JWT_SECRET=dev-only-pooler-jwt-secret-change-me-0000

# --- S3-compatible test service (compose profile s3-test; local dev and tests only) ---
S3_TEST_ACCESS_KEY=dev-only-s3-access-key
S3_TEST_SECRET_KEY=dev-only-s3-secret-key-change-me
S3_TEST_BUCKET=hattisar-test
